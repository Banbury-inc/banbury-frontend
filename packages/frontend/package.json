    "postcss": "^8.4.49",
    "prettier": "^3.5.3",
    "prettier-eslint": "^16.3.0",
    "prettier-plugin-organize-imports": "^4.0.0",
    "rimraf": "^5.0.5",
    "tailwindcss": "^3.4.17",
    "thread-loader": "^4.0.4",
    "ts-jest": "^29.2.4",
    "ts-loader": "^9.3.1",
    "ts-node": "^10.9.1",
    "typedoc": "^0.28.0",
    "typescript": "^5.8.2",
