    "webpack-dev-server": "^4.15.1",
    "ws": "^8.18.0"
  },
  "importSort": {
    ".js, .jsx, .es6, .es": {
      "parser": "babylon",
      "style": "renke"
    },
    ".ts, .tsx": {
      "parser": "typescript",
      "style": "renke"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "build": {
    "productName": "Banbury",
    "appId": "com.banbury.cloud",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "buildDependenciesFromSource": false,
    "nodeGypRebuild": false,
    "npmRebuild": false,
    "includeSubNodeModules": false,
    "beforeBuild": "node scripts/prepackage.js",
    "win": {
      "target": [
        "nsis",
        "msi"
      ],
      "icon": "static/NeuraNet_Icons/web/icon-512.png",
      "signAndEditExecutable": false,
      "publish": [
        "github"
      ]
    },
    "mac": {
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        "dmg",
        "pkg",
        "zip"
      ],
      "icon": "static/NeuraNet_Icons/macos/AppIcon.icns",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "publish": [
        "github"
      ]
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "icon": "static/NeuraNet_Icons/macos/AppIcon.icns",
      "category": "Utility",
      "executableName": "banbury",
      "synopsis": "A decentralized cloud storage system",
      "artifactName": "${productName}-${version}.${ext}",
      "publish": [
        "github"
      ]
    },
    "files": [
      "package.json",
      "dist/**",
      "dist/renderer/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Banbury-inc",
        "repo": "banbury-frontend"
      }
    ],
    "extraResources": []
  },
  "engines": {
    "npm": ">=10.0.0",
    "node": ">=20.0.0"
  }
}
